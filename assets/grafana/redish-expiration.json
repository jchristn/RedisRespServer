    },
    {
      "type": "text",
      "title": "Traces",
      "options": {
        "mode": "markdown",
        "content": "Sweeps that expire keys or fail are traced as `redish.expiration.sweep` roots with `stage:queued`, `stage:snapshot`, and `stage:evict` children; idle sweeps emit metrics only. In Explore, choose **Tempo** and query `{ name = \"redish.expiration.sweep\" }`."
      },
      "id": 15,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 39
      }
    },
    {
      "type": "logs",
      "title": "Server logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"redish-server\"}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 42
      }
