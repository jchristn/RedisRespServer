      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (redish_stage, outcome) (rate(redish_expiration_stage_events_total[$__rate_interval]))",
          "legendFormat": "{{redish_stage}} {{outcome}}",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "type": "row",
      "title": "Keys",
