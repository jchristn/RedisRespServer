      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (generation) (process_runtime_dotnet_gc_heap_size_bytes{job=\"redish\"})",
          "legendFormat": "{{generation}}",
          "refId": "A"
        }
      ],
