    {
      "type": "table",
      "title": "Recent error traces",
      "description": "Traces whose spans ended in Error (failed commands, failed sweeps, 5xx in the dashboard backend). Click a trace ID to open the waterfall.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "logs",
      "title": "Server warnings and errors",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"redish-server\"} | severity_text=~\"(?i)warn.*|error|critical|fatal\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 18,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      }
    }
  ]
